# Docker Compose development defaults. For native host execution, replace `db` and `redis` with
# `localhost` or omit this file to use SQLite and the built-in local defaults.
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DATABASE_URL=postgres://tenant_bill:tenant_bill@db:5432/tenant_bill
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# Replace these placeholders to exercise real Stripe test-mode synchronization and signed webhooks.
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
LOG_LEVEL=INFO
LOG_FORMAT=json
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
